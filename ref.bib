	year = {2023},
	keywords = {Language Server Protocol, Conceptual Modeling, Integrated Development Environment, Modeling tools, Software Engineering},
	pages = {9:1--16},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\FHBGL3ZL\\Bork and Langer - 2023 - Language Server Protocol An Introduction to the Protocol, its Use, and Adoption for Web Modeling To.pdf:application/pdf},
