	file = {ch138:C\:\\Users\\Admin\\Zotero\\storage\\HMXQMCDW\\ch138.pdf:application/pdf;PDF:C\:\\Users\\Admin\\Zotero\\storage\\6VBNABFS\\Indulska and Recker - 2008 - Design science in IS research a literature analysis.pdf:application/pdf},
}

