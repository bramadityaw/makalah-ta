@misc{kollin_lived_2022,
	type = {fi={AMK}-opinnäytetyö{\textbar}sv={YH}-examensarbete{\textbar}en={Bachelor}'s thesis{\textbar}},
	title = {Lived {Experience} of a {Junior} {Software} {Developer}},
	copyright = {fi=All rights reserved. This publication is copyrighted. You may download, display and print it for Your own personal use. Commercial use is prohibited.{\textbar}sv=All rights reserved. This publication is copyrighted. You may download, display and print it for Your own personal use. Commercial use is prohibited.{\textbar}en=All rights reserved. This publication is copyrighted. You may download, display and print it for Your own personal use. Commercial use is prohibited.{\textbar}},
	url = {http://www.theseus.fi/handle/10024/711292},
	abstract = {This is a diary thesis of a junior software developer in his first ever IT job in a logistics company. The observation period covers a 10-week period from Nov.1, 2021 to Jan. 7, 2022.   
 
The author’s main task is to update the company’s Customs Clearance and Order Tracking web portal, an online service for processing customs declarations. JavaScript and React were the most commonly used technologies in this assignment. Nielsen’s 10 Usability Heuristics were observed throughout the process of designing and Scrum was implemented to manage the project. There was also collaborative design within cross-functional teams to deliver to the users a well-thought of online service to cater to their needs. 
 
The thesis will contain daily analyses of a beginning-stage actor in the IT field which contains the day’s goals, problems encountered and things that have been done successfully. There will be weekly analyses as well to detail the skills developed and reflect on what lessons had been gained or things to improve on.  
 
This thesis will provide insight for those interested in the experiences of a junior software developer with no prior experience. The tasks assigned were those familiar with the author’s skillset. Also, as a foreigner in a Finnish company, this thesis will be an open book as to how it is like first-hand. Although Finnish is the mode of language, people are very understanding when it comes to social situations and also try to include everyone in conversations.  
 
There are more information with regards to the common problems encountered at work like being stuck or hitting a programming wall and ways to solve them. There are also some communication tips to enhance social skills in speaking in Finnish. The thesis also provides important learnings related to programming, user experience and user interface design. 
 
At the end of the observation period, the web portal was launched successfully and with it comes development with regards to the improvement of skillset. Having spent only six months at work was very beneficial but not to the point that it will make people an expert at things. There is always something to learn and things are developing rapidly in programming. However, with time, patience, and the burning desire to code, to be an experienced specialist after a couple of years is not impossible.},
	language = {eng},
	urldate = {2025-11-11},
	author = {Kollin, Ruskin},
	year = {2022},
	note = {Accepted: 2022-03-04T09:02:20Z},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\VUDJ6698\\Kollin - 2022 - Lived Experience of a Junior Software Developer.pdf:application/pdf},
}

@article{schorsch_increasing_1990,
	title = {Increasing the {Readability} and {Comprehensibility} of {Programs}},
	url = {https://apps.dtic.mil/sti/html/tr/ADA231805/},
	abstract = {Source code must be readable and understandable in order to be debugged, used, and maintained efficiently and effectively. Creating programs that are easily read and understood is important, but not as simple as one might think. This thesis surveys the ways in which programming style, programming language design and program presentation influence a persons ability to read and understand program text. It is concerned with solving small scale problems associated with individual functions or files and not with problems that pertain exclusively to large software systems. The programming style chapter examines the changes a programmer may make to source code without modifying the content or meaning of the code. Two of tha main sections cover code reformatting and identifier naming conventions. The chapter on language design discusses the selection of basic tokens symbols and keywords and the structure of language statements. This chapter also categorizes the subtle errors that occur when the meanings of a code segment when read and when executed are not the same. The program presentation chapter presents methods for enhancing completed source code making it easier to read and its true meaning easier to discern. Restructuringtransforming the code, graphic design principles, and introducing supplemental information are some of the main sections. Knuths literate programming paradigm is examined in this chapter as well. One of the underlying themes of the thesis is that an automated proofreader program could greatly aid programmers to create readable, understandable programs.},
	language = {en},
	urldate = {2025-11-11},
