@misc{valiulla_comparative_2025,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Comparative {Analysis} of {Engineering} {Performance} and {Experience} {Frameworks}: {DORA}, {SPACE}, {HEART}, and {Beyond}},
	shorttitle = {Comparative {Analysis} of {Engineering} {Performance} and {Experience} {Frameworks}},
	url = {https://papers.ssrn.com/abstract=5335258},
	doi = {10.2139/ssrn.5335258},
	abstract = {The measurement of software engineering effectiveness has evolved into a critical discipline for technology organizations seeking to enhance performance, productivity, and the developer experience. In an era where developer talent is a primary business constraint and software delivery capability is a key market differentiator, a robust understanding of engineering performance is paramount. This paper provides a comprehensive comparative analysis of the most prominent measurement frameworks: DORA, SPACE, HEART, CALMS, Accelerate, AARRR Metrics, the Flow Framework, OKRs, and others. For each framework, we present its definition, origins, key metrics, and a detailed SWOT analysis. A comparative matrix and a novel Magic Quadrant for Engineering Measurement Frameworks synthesize the analysis, mapping each framework based on its Holism of Measurement and its Ease of Implementation. The paper further introduces a crucial discussion on practical implementation strategies and common anti-patterns to avoid, such as metric weaponization and a narrow focus on outputs. We also discuss how these frameworks complement or conflict, offering recommendations for practitioners on creating a balanced measurement portfolio. Looking forward, we identify critical gaps in existing models and explore the future of engineering measurement, including the impact of AI-driven analytics and the move toward integrated socio-technical system views. This work aims to provide a structured, critical guide for navigating the complex terrain of engineering metrics, enabling organizations to make data-informed decisions that drive sustainable improvement and foster a culture of engineering excellence.},
	language = {en},
	urldate = {2025-11-26},
	publisher = {Social Science Research Network},
	author = {Valiulla, Adeeb},
	month = jul,
	year = {2025},
	keywords = {Cognitive Load, Developer Experience, Developer Productivity, DevOps, DORA, Engineering Performance, HEART, Magic Quadrant, Platform Engineering, Socio-technical Systems, Software Metrics, SPACE, SWOT Analysis, Value Stream Metrics},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\4LSTWCK5\\Valiulla - 2025 - Comparative Analysis of Engineering Performance and Experience Frameworks DORA, SPACE, HEART, and B.pdf:application/pdf},
}

@incollection{graziotin_are_2013,
	title = {Are {Happy} {Developers} more {Productive}? {The} {Correlation} of {Affective} {States} of {Software} {Developers} and their self-assessed {Productivity}},
	volume = {7983},
	shorttitle = {Are {Happy} {Developers} more {Productive}?},
	url = {http://arxiv.org/abs/1306.1772},
	abstract = {For decades now, it has been claimed that a way to improve software developers' productivity is to focus on people. Indeed, while human factors have been recognized in Software Engineering research, few empirical investigations have attempted to verify the claim. Development tasks are undertaken through cognitive processing abilities. Affective states - emotions, moods, and feelings - have an impact on work-related behaviors, cognitive processing activities, and the productivity of individuals. In this paper, we report an empirical study on the impact of affective states on software developers' performance while programming. Two affective states dimensions are positively correlated with self-assessed productivity. We demonstrate the value of applying psychometrics in Software Engineering studies and echo a call to valorize the human, individualized aspects of software developers. We introduce and validate a measurement instrument and a linear mixed-effects model to study the correlation of affective states and the productivity of software developers.},
	urldate = {2025-11-26},
	author = {Graziotin, Daniel and Wang, Xiaofeng and Abrahamsson, Pekka},
	year = {2013},
	doi = {10.1007/978-3-642-39259-7_7},
	note = {arXiv:1306.1772 [cs]},
	keywords = {Computer Science - Human-Computer Interaction, Computer Science - Software Engineering},
	pages = {50--64},
	file = {Preprint PDF:C\:\\Users\\Admin\\Zotero\\storage\\7JUJGNXH\\Graziotin et al. - 2013 - Are Happy Developers more Productive The Correlation of Affective States of Software Developers and.pdf:application/pdf;Snapshot:C\:\\Users\\Admin\\Zotero\\storage\\M2DTHQQ2\\1306.html:text/html},
