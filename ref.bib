	pages = {151--172},
	file = {Full Text PDF:C\:\\Users\\Admin\\Zotero\\storage\\XDXMKHH9\\Indriasari et al. - 2024 - Requirements Engineering of Knowledge Management System for Smallholder Dairy Farmers.pdf:application/pdf},
}

